<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform build (macOS/Linux/Windows).
    Targets .NET Framework 4.7.2 (RimWorld's runtime) using the net472 reference assemblies
    NuGet package, so no Windows/Mono install is required to compile. Krafs.Publicizer
    publicizes Assembly-CSharp at build time, so you do NOT need a pre-made
    Assembly-CSharp_publicized.dll.

    You must supply RimWorld's managed DLLs (not redistributable). Point RimWorldManaged at your
    RimWorld install's "Managed" folder, e.g.:
      - macOS (Steam): ~/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Contents/Resources/Data/Managed
      - Windows (Steam): C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed
    Override on the command line with:  dotnet build -c Release -p:RimWorldManaged="/path/to/Managed"
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TradeUI</AssemblyName>
    <RootNamespace>TradeUI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the existing Properties/AssemblyInfo.cs instead of an auto-generated one -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!--
      Default to the repo's git-ignored do_not_upload/Managed folder (drop RimWorld's managed
      DLLs there). Override with -p:RimWorldManaged=... to point elsewhere.
    -->
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">$(MSBuildProjectDirectory)/../../do_not_upload/Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Publicize the game assembly so internal/private members are accessible at compile time -->
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <!-- RimWorld + Unity managed references (not copied to output) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.InputModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RimWorldManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the loadable mod folder for 1.6 (cross-platform copy) -->
  <Target Name="CopyToModFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildProjectDirectory)/../../TradeUI/v1.6/Assemblies" />
    <Message Importance="high" Text="Copied $(TargetFileName) -> TradeUI/v1.6/Assemblies/" />
  </Target>

</Project>
